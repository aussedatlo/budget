CREATE TABLE snapshots (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date INTEGER NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    main_income REAL NOT NULL DEFAULT 0,
    other_income REAL NOT NULL DEFAULT 0,
    repayments REAL NOT NULL DEFAULT 0,
    charges REAL NOT NULL DEFAULT 0,
    savings REAL NOT NULL DEFAULT 0
);

-- A charge or an income line as it was in a snapshot, in list order.
CREATE TABLE snapshot_lines (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    snapshot_id INTEGER NOT NULL REFERENCES snapshots(id),
    -- 'charge' or 'income'
    kind TEXT NOT NULL,
    position INTEGER NOT NULL,
    title TEXT NOT NULL,
    amount REAL NOT NULL,
    category TEXT NOT NULL DEFAULT ''
);

CREATE INDEX snapshot_line_snapshot ON snapshot_lines(snapshot_id);

selectAll:
SELECT * FROM snapshots ORDER BY date, id;

selectAllLines:
SELECT * FROM snapshot_lines ORDER BY snapshot_id, kind, position;

insert:
INSERT INTO snapshots (date, note, main_income, other_income, repayments, charges, savings) VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE snapshots SET date = ?, note = ?, main_income = ?, other_income = ?, repayments = ?, charges = ?, savings = ? WHERE id = ?;

delete:
DELETE FROM snapshots WHERE id = ?;

insertLine:
INSERT INTO snapshot_lines (snapshot_id, kind, position, title, amount, category) VALUES (?, ?, ?, ?, ?, ?);

deleteLinesOf:
DELETE FROM snapshot_lines WHERE snapshot_id = ?;

deleteAll {
    DELETE FROM snapshot_lines;
    DELETE FROM snapshots;
}
