CREATE TABLE income_sources (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    amount REAL NOT NULL,
    emoji TEXT NOT NULL DEFAULT '💼',
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL
);

selectAll:
SELECT * FROM income_sources ORDER BY created_at, id;

insert:
INSERT INTO income_sources (title, amount, emoji, is_active, created_at) VALUES (?, ?, ?, ?, ?);

update:
UPDATE income_sources SET title = ?, amount = ?, emoji = ?, is_active = ?, created_at = ? WHERE id = ?;

updateAmount:
UPDATE income_sources SET amount = ?, is_active = ? WHERE id = ?;

delete:
DELETE FROM income_sources WHERE id = ?;

deleteAll:
DELETE FROM income_sources;
